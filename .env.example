# Telegram
TELEGRAM_BOT_TOKEN=
ALLOWED_CHAT_IDS=
TIMEZONE=

# Bot LLM: deepseek | anthropic
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
# Optional overrides of the provider defaults
LLM_MODEL=
LLM_MEMORY_MODEL=
LLM_BASE_URL=

# Retell
RETELL_API_KEY=
RETELL_FROM_NUMBER=
RETELL_AGENT_ID_ES=
RETELL_AGENT_ID_EN=
RETELL_AGENT_ID_RU=

# Owner
OWNER_NAME=
OWNER_SURNAME=
OWNER_NAME_RU=
OWNER_SURNAME_RU=
OWNER_PHONE=
# Optional: f or m, for grammatical gender when the robot speaks about the owner
OWNER_GENDER=

# Google Calendar (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_IDS=primary

# Optional: SQLite file (default data/zvonilka.db)
DB_PATH=
